# Required for the built-in Next.js chatbot API.
OPENAI_API_KEY=your_openai_api_key

# Cost-sensitive model suitable for a portfolio assistant.
OPENAI_MODEL=gpt-5.6-luna

# Optional. Comma-separated origins allowed to call /api/chat from a static site.
# CHAT_ALLOWED_ORIGINS=https://your-name.github.io,http://localhost:3000

# Optional. Set this in the frontend build when the chatbot API is hosted elsewhere.
# NEXT_PUBLIC_CHAT_API_URL=https://your-chat-api.example.com/api/chat
